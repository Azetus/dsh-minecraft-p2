{
  "name": "dsh-minecraft-p2",
  "version": "0.2.3",
  "description": "A DeepSeek Harness plugin that brings a second player into your Minecraft Java Edition world. Chat with it in-game and ask it to mine, gather materials, or place blocks.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azetus/dsh-minecraft-p2.git"
  },
  "homepage": "https://github.com/Azetus/dsh-minecraft-p2#readme",
  "bugs": {
    "url": "https://github.com/Azetus/dsh-minecraft-p2/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "minecraft",
    "mineflayer",
    "agent",
    "automation"
  ],
  "main": "./lib/bridge.js",
  "types": "./lib/bridge/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/bridge/index.d.ts",
      "default": "./lib/bridge.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "content/**",
    "skills/**",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --pool=threads",
    "check": "npm run build && npm run typecheck && npm run test",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:check": "node scripts/dev.mjs --no-start",
    "dev:smoke": "node scripts/dev-api-smoke.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "metrics:summary": "node scripts/metrics-summary.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "minecraft-data": "3.114.0",
    "minecraft-protocol": "1.67.0",
    "mineflayer": "4.39.0",
    "vec3": "0.1.10"
  }
}
